#!/bin/sh
# ============================================================================
# commitments : the owner's ordered list, enforced at dispatch, measured by script.
# ----------------------------------------------------------------------------
# ROADBLOCKS REMOVED (ROADBLOCK-REGISTER.md, "Management roadblocks", thread 0012)
#   F21 work picked by what is closest to landing, not by the owner's order.
#   F22 a promise bigger than delivery, set by the manager's guess.
#   F23 progress figures guessed and reported as measured.
#   F24 too many slices at once (agents and usage limits exhausted).
#   F25 an owner instruction that never becomes a row, so no check can see it.
#   F26 "done" asserted without the done-check that proves it.
#
# THE FILES (in the MAIN checkout's .team/, override with TEAM_DIR)
#   COMMITMENTS.md  the owner's ordered list. Row order IS the priority. Columns:
#                     | id | commitment | status | finished | stamp |
#                   status: open | active | blocked: <reason> | done | standing
#                   standing: an obligation the project's own rules require every week
#                   (never done). It may be dispatched in any order, but only under the
#                   cap; while it runs it is "standing: active" and counts toward the cap
#                   until `commitments release`. It never counts as promised or finished.
#                   finished and stamp are written by `commitments done`, never by hand.
#                   The id should match the task id on the board (.team/TASKS.md), so
#                   done-check can resolve it.
#   INBOX.md        owner messages, appended by enforcement/hooks/owner-inbox. PRIVATE:
#                   kept at <git-common-dir>/rat/INBOX.md, never in .team or the work
#                   tree, so it can never be committed or pushed. A 1.3.0 .team/INBOX.md
#                   is moved there; one tracked by git stops every command (exit 2).
#                   Nothing here prints a message's text, only ids and dates.
#                     | id | date | status | excerpt |
#                   status: untriaged | row=<id> | declined: <reason>
#                   or peer: written by another session, a subagent or the app (the
#                   prompt opened with a harness envelope). The report lists the last
#                   7 days of them; they never block dispatch and need no triage.
#   wip-cap         first non-comment line: the most rows that may be active at once.
#                   Absent: 2. The owner sets it.
#   ABSENT COMMITMENTS.md: the management checks are off (dispatch passes). Present: on.
#
# USAGE
#   commitments dispatch <id>          the check new-session runs before a producer
#                                      session starts. Refuses (exit 1) while any inbox
#                                      item is untriaged, when <id> is done or blocked,
#                                      when <id> is open but not the TOP open row, or when
#                                      the active rows are at the cap. Joining an already
#                                      active row is allowed. On pass, marks <id> active.
#                                      Also run by enforcement/hooks/dispatch-agent for
#                                      every Agent / start-session call a manager makes.
#   commitments release <id>          a running standing row goes back to standing.
#   commitments block <id> <reason>    mark a row blocked, so the next open row becomes
#                                      the top. The reason is required.
#   commitments done <id> [--branch B] runs scripts/done-check --task <id> on an ACTIVE row,
#                                      every other input from the board. Only on exit 0 does it mark the row done and write the
#                                      finished date and the stamp.
#   commitments triage <inbox-id> row=<id> | declined:<reason>
#   commitments promise [--weeks N]    rows promised this week, computed from rows finished
#                                      in the last N complete weeks (default 3). The
#                                      manager cannot set it.
#   commitments report [--deadline YYYY-MM-DD]
#                                      the only progress report: promised vs finished,
#                                      the list in order, untriaged inbox items, done rows
#                                      with no stamp (counted NOT done), and with a deadline
#                                      which open rows fit at the measured rate.
#
# EXIT CODES  0 ok / passed.  1 refused (the reason is printed).  2 usage or setup error.
#
# HISTORY START: the weeks counted for the promise start at the commit that first added
# COMMITMENTS.md (git log), so an empty early week is a real zero, not a guess.
# TEAM_TODAY=YYYY-MM-DD overrides today's date (for tests).
# ============================================================================

set -eu

PROG="$(basename "$0")"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
usage() { sed -n '2,67p' "$0" | sed 's/^# \{0,1\}//'; }
die()  { code="$1"; shift; printf '%s: %s\n' "$PROG" "$*" >&2; exit "$code"; }

if [ -z "${TEAM_DIR:-}" ]; then
	git rev-parse --git-dir >/dev/null 2>&1 || die 2 "not inside a git repository (or set TEAM_DIR)."
	# substr, not $2: a repo path with a space must not cut the root (and turn every check off).
	MAIN_ROOT=$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print substr($0, 10); exit}')
	[ -n "${MAIN_ROOT:-}" ] || MAIN_ROOT=$(git rev-parse --show-toplevel)
	TEAM_DIR="$MAIN_ROOT/.team"
fi
LIST="$TEAM_DIR/COMMITMENTS.md"
# The owner's messages live in the git directory, never in the work tree (owner ruling
# 2026-11-18). See enforcement/lib/owner-inbox-path.sh.
. "${OWNER_INBOX_LIB:-$SCRIPT_DIR/../enforcement/lib/owner-inbox-path.sh}"
INBOX=$(owner_inbox_path) || INBOX=""
if [ -n "$INBOX" ]; then
	set +e; owner_inbox_migrate "$TEAM_DIR" "$INBOX"; MRC=$?; set -e
	[ "$MRC" -ne 3 ] || die 2 "$OWNER_INBOX_TRACKED_MSG"
	[ "$MRC" -ne 4 ] || echo "commitments: an old $TEAM_DIR/INBOX.md is still in the work tree beside the private inbox $INBOX. Check it and delete it." >&2
fi
CAPFILE="$TEAM_DIR/wip-cap"
LOCK="$TEAM_DIR/.commitments.lock"
TODAY="${TEAM_TODAY:-$(date +%Y-%m-%d)}"
case "$TODAY" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;; *) die 2 "TEAM_TODAY must be YYYY-MM-DD." ;; esac

# One-line values only: a pipe forges a column, a newline forges a row, and a backslash
# is refused too so no escape can turn into either later.
one_line() {  # one_line <label> <value>
	[ -n "$2" ] || die 2 "$1 is required."
	case "$2" in *'|'*|*'\'*) die 2 "$1 must not contain '|' or a backslash." ;; esac
	[ "$(printf '%s' "$2" | wc -l | tr -d ' ')" -eq 0 ] || die 2 "$1 must not contain a newline."
	[ "${#2}" -le 200 ] || die 2 "$1 must be 200 characters or fewer."
}
valid_id() {  # valid_id <label> <value>: ids are letters, digits, dot, underscore, hyphen
	one_line "$1" "$2"
	case "$2" in *[!A-Za-z0-9._-]*) die 2 "$1 may contain only letters, digits, dot, underscore, hyphen." ;; esac
}

# The event log: lock reclaims and standing-row releases, one line each, committed with .team.
LOG="$TEAM_DIR/commitments.log"
log_event() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }
who() {  # the session id in .team/whoami at the repo top, or "unknown"
	_t=$(git rev-parse --show-toplevel 2>/dev/null || true)
	_w=$(sed -e 's/#.*$//' "$_t/.team/whoami" 2>/dev/null | grep -v -i '^[[:space:]]*role[[:space:]]*=' | tr -d ' \r' | grep -v '^$' | head -n 1)
	printf '%s' "${_w:-unknown}" | tr -cd 'A-Za-z0-9._:-'
}

# One state change at a time: read, check and write happen under this lock, so two
# dispatches at the same moment cannot both pass the cap. mkdir is atomic everywhere.
# The lock holds "<pid> <epoch>", written with noclobber so only one writer can own a
# given lock directory. A lock is reclaimed (and the reclaim logged) ONLY when its owner
# pid is dead, or when it has shown no owner line for 2 seconds in a row. A live holder
# is never robbed, however long it stalls: the waiter refuses with BUSY instead. The
# whole wait stays near LOCK_WAIT seconds, far under the hook timeout (30 s for
# dispatch-agent), so a held lock never outlasts the hook.
LOCK_WAIT=5
lock() {
	_end=$(( $(date +%s) + LOCK_WAIT )); _empty_since=""; _own=""
	while :; do
		_now=$(date +%s)
		if mkdir "$LOCK" 2>/dev/null; then
			_me="$$ $_now"
			if ( set -C; printf '%s\n' "$_me" > "$LOCK/owner" ) 2>/dev/null \
				&& [ "$(cat "$LOCK/owner" 2>/dev/null || true)" = "$_me" ]; then
				# Release only our own lock: never remove one a reclaim handed to someone else.
				trap '[ "$(cat "$LOCK/owner" 2>/dev/null || true)" = "$_me" ] && rm -rf "$LOCK"' EXIT INT TERM
				return 0
			fi
			# Lost it between mkdir and the owner line (a reclaim, or another writer): retry.
		else
			_own=$(cat "$LOCK/owner" 2>/dev/null || true)
			_pid=${_own%% *}
			_stale=0
			case "$_pid" in
				''|*[!0-9]*)
					[ -n "$_empty_since" ] || _empty_since=$_now
					[ $((_now - _empty_since)) -ge 2 ] && _stale=1 ;;
				*)
					_empty_since=""
					kill -0 "$_pid" 2>/dev/null || _stale=1 ;;
			esac
			if [ "$_stale" -eq 1 ] && mv "$LOCK" "$LOCK.stale.$$" 2>/dev/null; then
				if [ "$(cat "$LOCK.stale.$$/owner" 2>/dev/null || true)" != "$_own" ] && [ ! -e "$LOCK" ]; then
					# The lock changed hands between our look and the move: put it back.
					mv "$LOCK.stale.$$" "$LOCK" 2>/dev/null || true
				else
					rm -rf "$LOCK.stale.$$"
					log_event "lock reclaimed (owner '${_own:-none}', holder gone) by $(who) pid $$"
				fi
				_empty_since=""
				continue
			fi
		fi
		[ "$_now" -lt "$_end" ] || die 1 "BUSY: $LOCK is held by live process '${_own:-none}'; nothing was changed, try again."
		sleep 0.2
	done
}

# Rows of a markdown table as "cell1|cell2|...", trimmed, header and rule rows dropped.
rows() {  # rows <file>
	[ -f "$1" ] || return 0
	awk -F '|' '
		/^[ \t]*\|/ {
			out = ""
			for (i = 2; i < NF; i++) { c = $i; gsub(/^[ \t]+|[ \t]+$/, "", c); out = out (i > 2 ? "|" : "") c }
			split(out, f, "|")
			if (f[1] == "id" || f[1] ~ /^-+$/ || f[1] == "") next
			print out
		}' "$1"
}

# Values reach awk through ENVIRON, never -v: -v expands escapes like \n and \174, which
# would let a reason forge a row. Ids compare as strings ("1" is not "01").
status_of() { rows "$LIST" | CM_ID="$1" awk -F '|' '($1 "") == ENVIRON["CM_ID"] { print $3; exit }'; }
top_open()  { rows "$LIST" | awk -F '|' '$3 == "open" { print $1; exit }'; }
# Active work: active rows plus standing rows currently running.
active_n()  { rows "$LIST" | awk -F '|' '$3 == "active" || $3 == "standing: active" { n++ } END { print n + 0 }'; }
untriaged() { rows "$INBOX" | awk -F '|' '$3 == "untriaged" { print $1 }'; }

# The cap: first non-comment line, a trailing "# note" ignored, 0 to 999. Absent: 2.
# Anything else prints "bad" and the caller refuses (a malformed cap fails closed).
cap() {
	[ -f "$CAPFILE" ] || { echo 2; return; }
	# Trim only the ends: "2 3" keeps its inner space and is refused, not read as 23.
	c=$(sed -e 's/#.*$//' "$CAPFILE" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | grep -v '^$' | head -n 1)
	case "$c" in '') echo 2 ;; *[!0-9]*) echo bad ;; ?|??|???) echo "$c" ;; *) echo bad ;; esac
}
cap_or_die() {
	C=$(cap)
	[ "$C" != bad ] || die 1 "REFUSED: $CAPFILE must hold a whole number from 0 to 999."
}

# Rewrite cells of the row whose id matches. Cells: 3 status, 4 finished, 5 stamp (in the
# trimmed numbering rows() uses); an empty new value leaves the cell as it is. A CRLF
# file keeps its CRs.
set_row() {  # set_row <file> <id> <status> <finished> <stamp>
	tmp="$1.tmp.$$"
	# Some awks (Git Bash) drop CRs on read, so CRLF is detected here and restored after.
	_cr=$(printf '\r')
	_crlf=0; [ "$(tr -cd '\r' < "$1" | wc -c | tr -d ' ')" -gt 0 ] && _crlf=1
	CM_ID="$2" CM_ST="$3" CM_FIN="$4" CM_STP="$5" awk -F '|' -v OFS='|' '
		{ sub(/\r$/, "") }
		/^[ \t]*\|/ {
			c = $2; gsub(/^[ \t]+|[ \t]+$/, "", c)
			if (c == ENVIRON["CM_ID"]) {
				if (ENVIRON["CM_ST"] != "")  $4 = " " ENVIRON["CM_ST"] " "
				if (ENVIRON["CM_FIN"] != "") $5 = " " ENVIRON["CM_FIN"] " "
				if (ENVIRON["CM_STP"] != "") $6 = " " ENVIRON["CM_STP"] " "
			}
		}
		{ print }' "$1" > "$tmp" || return 1
	if [ "$_crlf" -eq 1 ]; then sed "s/\$/$_cr/" "$tmp" > "$tmp.cr" && mv "$tmp.cr" "$tmp"; fi
	mv "$tmp" "$1"
}

# Day number of a YYYY-MM-DD date, portable (no GNU date -d).
DAYS_AWK='function days(s,  y, m, d, era, yoe, doy, doe) {
	y = substr(s, 1, 4) + 0; m = substr(s, 6, 2) + 0; d = substr(s, 9, 2) + 0
	if (m <= 2) y--
	era = int(y / 400); yoe = y - era * 400
	doy = int((153 * (m > 2 ? m - 3 : m + 9) + 2) / 5) + d - 1
	doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
	return era * 146097 + doe - 719468
}'

# The date COMMITMENTS.md was first committed, or empty.
started() {
	git -C "$TEAM_DIR" log --diff-filter=A --format=%cs -- COMMITMENTS.md 2>/dev/null | tail -n 1
}

# Prints "promise finished weeks" (promise is "-" with no history).
compute_promise() {  # compute_promise <weeks>
	rows "$LIST" | awk -F '|' -v today="$TODAY" -v start="$(started)" -v n="$1" "$DAYS_AWK"'
		BEGIN { t = days(today); ws = t - (t + 3) % 7 }
		$3 == "done" && $5 != "" && $4 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ {
			d = days($4); if (d >= ws - 7 * n && d < ws) f++
		}
		END {
			w = 0
			if (start != "") { s = days(start); sw = s - (s + 3) % 7; w = int((ws - sw) / 7); if (w > n) w = n }
			if (w <= 0) { print "- " f + 0 " 0"; exit }
			print int(f / w) " " f + 0 " " w
		}'
}

[ -n "${1:-}" ] || { usage; exit 2; }
CMD="$1"; shift

case "$CMD" in
	-h|--help) usage; exit 0 ;;

	dispatch)
		ID="${1:-}"; valid_id "row id" "$ID"
		[ -f "$LIST" ] || { echo "commitments: no $LIST, management checks off."; exit 0; }
		lock
		U=$(untriaged | tr '\n' ' ')
		[ -z "$U" ] || die 1 "REFUSED (F25): owner messages not triaged: $U. Map each to a row or decline it with a reason: $PROG triage <inbox-id> row=<id> | declined:<reason>"
		ST=$(status_of "$ID")
		case "$ST" in
			"") die 1 "REFUSED (F21): '$ID' is not a row in $LIST." ;;
			active|"standing: active") echo "commitments: '$ID' is already running; joining it."; exit 0 ;;
			standing|open) : ;;
			done) die 1 "REFUSED (F21): '$ID' is done." ;;
			blocked*) die 1 "REFUSED (F21): '$ID' is $ST." ;;
			*) die 1 "REFUSED: '$ID' has unknown status '$ST' (open, active, blocked: <reason>, done, standing)." ;;
		esac
		if [ "$ST" = open ]; then
			TOP=$(top_open)
			[ "$TOP" = "$ID" ] || die 1 "REFUSED (F21): '$ID' is not the top open row; the top open row is '$TOP'. Work the list in the owner's order, or block the top row with a reason."
		fi
		N=$(active_n); cap_or_die
		[ "$N" -lt "$C" ] || die 1 "REFUSED (F24): $N rows running, the cap is $C ($CAPFILE). Finish, block or release one first."
		if [ "$ST" = open ]; then set_row "$LIST" "$ID" active "" ""; else set_row "$LIST" "$ID" "standing: active" "" ""; fi
		echo "commitments: '$ID' dispatched (running $((N + 1)) of $C)."
		;;

	release)
		ID="${1:-}"; valid_id "row id" "$ID"
		lock
		[ "$(status_of "$ID")" = "standing: active" ] || die 1 "'$ID' is not a running standing row; only a standing row is released (other rows finish with done or block)."
		set_row "$LIST" "$ID" standing "" ""
		log_event "standing row $ID released by $(who)"
		echo "commitments: standing row '$ID' released."
		;;

	block)
		ID="${1:-}"; valid_id "row id" "$ID"; shift
		WHY="$*"; one_line "reason" "$WHY"
		lock
		ST=$(status_of "$ID")
		case "$ST" in open|active) : ;; "") die 1 "'$ID' is not a row." ;; *) die 1 "'$ID' is $ST; only an open or active row can be blocked." ;; esac
		set_row "$LIST" "$ID" "blocked: $WHY" "" ""
		echo "commitments: '$ID' blocked: $WHY"
		;;

	done)
		ID="${1:-}"; valid_id "row id" "$ID"; shift
		# Only the branch may be chosen. Every other done-check input (class, gates,
		# artifact, extra checks, ledger, board, task) comes from the board, so a row
		# cannot be stamped on skipped or borrowed proof.
		DC_BRANCH=""
		while [ $# -gt 0 ]; do
			case "$1" in
				--branch)
					DC_BRANCH="${2:-}"; one_line "branch" "$DC_BRANCH"
					git check-ref-format --branch "$DC_BRANCH" >/dev/null 2>&1 || die 2 "--branch '$DC_BRANCH' is not a valid branch name."
					shift 2 ;;
				*) die 2 "done takes only --branch <name>; '$1' is refused (class, gates, artifact and task come from the board)." ;;
			esac
		done
		[ "$(status_of "$ID")" = active ] || die 1 "NOT DONE (F26): '$ID' is not active; only a dispatched row can be done."
		set +e
		if [ -n "$DC_BRANCH" ]; then sh "$SCRIPT_DIR/done-check" --task "$ID" --branch "$DC_BRANCH"; else sh "$SCRIPT_DIR/done-check" --task "$ID"; fi
		RC=$?
		set -e
		[ "$RC" -eq 0 ] || die 1 "NOT DONE (F26): done-check exited $RC; '$ID' stays as it was."
		lock
		[ "$(status_of "$ID")" = active ] || die 1 "NOT DONE: '$ID' changed while done-check ran; run done again."
		SHA=$(git rev-parse --short=12 HEAD)
		set_row "$LIST" "$ID" done "$TODAY" "done-check exit 0 at $SHA"
		echo "commitments: '$ID' done (done-check exit 0 at $SHA)."
		;;

	triage)
		MID="${1:-}"; valid_id "inbox id" "$MID"; shift
		TO="$*"; one_line "triage" "$TO"
		case "$TO" in
			row=*) valid_id "row id" "${TO#row=}" ;;
			declined:?*) : ;;
			*) die 2 "triage is row=<id> or declined:<reason>." ;;
		esac
		lock
		[ -n "$(rows "$INBOX" | CM_ID="$MID" awk -F '|' '($1 "") == ENVIRON["CM_ID"] { print 1 }')" ] || die 1 "'$MID' is not in $INBOX."
		case "$TO" in row=*) [ -n "$(status_of "${TO#row=}")" ] || die 1 "'${TO#row=}' is not a row in $LIST; add the row first." ;; esac
		set_row "$INBOX" "$MID" "$TO" "" ""
		echo "commitments: $MID triaged: $TO"
		;;

	promise)
		W=3; [ "${1:-}" = "--weeks" ] && W="${2:-3}"
		case "$W" in ''|*[!0-9]*|0) die 2 "--weeks takes a positive whole number." ;; esac
		set -- $(compute_promise "$W")
		if [ "$1" = "-" ]; then echo "promise: none yet (no complete week of history)"; else echo "promise: $1 rows a week ($2 finished over the last $3 complete weeks)"; fi
		;;

	report)
		DL=""; [ "${1:-}" = "--deadline" ] && DL="${2:-}"
		case "$DL" in ""|[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;; *) die 2 "--deadline must be YYYY-MM-DD." ;; esac
		[ -f "$LIST" ] || die 2 "no $LIST."
		set -- $(compute_promise 3); P="$1"; PF="$2"; PW="$3"
		printf 'COMMITMENTS REPORT %s (generated by scripts/commitments; no figure here is hand-written)\n' "$TODAY"
		if [ "$P" = "-" ]; then echo "Promise this week: none yet (no complete week of history)"; else echo "Promise this week: $P rows (measured: $PF finished over the last $PW weeks)"; fi
		rows "$LIST" | awk -F '|' -v today="$TODAY" -v p="$P" -v dl="$DL" -v pr="$P" "$DAYS_AWK"'
			BEGIN { t = days(today); ws = t - (t + 3) % 7 }
			{
				n++; id[n] = $1; st[n] = $3; fin[n] = $4; stp[n] = $5
				if ($3 == "done" && $5 == "") bad = bad " " $1
				if ($3 == "done" && $5 != "" && days($4) >= ws) wk++
			}
			END {
				printf "Finished this week: %d", wk + 0; if (p != "-") printf " of %d promised", p; printf "\n"
				print "The list, in the owner'"'"'s order:"
				k = 0
				for (i = 1; i <= n; i++) {
					s = st[i]; if (s == "done" && stp[i] == "") s = "NOT DONE (no done-check stamp)"
					mark = ""
					if (s != "done" && s !~ /^standing/ && s !~ /^blocked/ && p != "-" && k < p) { mark = "  [in this week'"'"'s promise]"; k++ }
					printf "  %d. %s  %s%s\n", i, id[i], s, mark
				}
				if (bad != "") print "Done rows with no stamp, counted NOT done:" bad
				if (dl != "") {
					if (p == "-" || p == 0) { print "Deadline " dl ": no measured rate yet, so no row can be shown to fit." }
					else {
						left = int((days(dl) - t + 6) / 7); room = left * p; fit = ""; miss = ""
						for (i = 1; i <= n; i++) if ((st[i] != "done" || stp[i] == "") && st[i] !~ /^blocked/ && st[i] !~ /^standing/) { if (room > 0) { fit = fit " " id[i]; room-- } else miss = miss " " id[i] }
						print "Deadline " dl ": " left " weeks at " p " a week."
						print "  Fits:" (fit == "" ? " none" : fit)
						print "  Does not fit:" (miss == "" ? " none" : miss)
					}
				}
			}'
		U=$(untriaged | tr '\n' ' ')
		echo "Untriaged owner messages: ${U:-none}"
		echo "Peer messages, last 7 days (listed, never block):"
		rows "$INBOX" | awk -F '|' -v today="$TODAY" "$DAYS_AWK"'
			$3 == "peer" && $2 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/ && days($2) > days(today) - 7 { printf "  %s %s\n", $1, $2; n++ }
			END { if (!n) print "  none" }'
		echo "Active rows: $(active_n) (cap $(cap))"
		;;

	*) die 2 "unknown command '$CMD' (try --help)." ;;
esac
