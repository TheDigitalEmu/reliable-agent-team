#!/bin/sh
# ============================================================================
# pre-push-gate : gate-before-merge guard (git pre-push hook)
# ----------------------------------------------------------------------------
# ROADBLOCKS REMOVED
#   - "Work merged before its gates pass" (F2). BLOCK.
#   - "Commits added to an already-gated tip (gate invalidated)". BLOCK.
#   See ROADBLOCK-REGISTER.md, Gate and quality roadblocks. The gate PASS is
#   bound to a SPECIFIC commit SHA, so a new commit on top of a gated tip
#   invalidates the gate and this hook re-requires it. Artifact:
#   enforcement/hooks/pre-push-gate + scripts/gate-check.
#
# WHAT IT DOES
#   git invokes a pre-push hook with the remote name and URL as arguments,
#   and feeds one line per ref being pushed on stdin:
#       <local ref> <local sha> <remote ref> <remote sha>
#   For every ref that targets the protected branch (default: main), this
#   hook shells out to gate-check-range for the WHOLE RANGE remote_sha..local_sha
#   (first-parent) and BLOCKS the push unless it exits 0. Pushes to any other
#   branch pass straight through. If the checker is missing it fails CLOSED.
#
# CONTRACT WITH gate-check-range (this hook does not implement gate logic)
#   scripts/gate-check-range --tip <local sha> --base <remote sha> --allow-tip-only
#     Every commit in the range is checked in gate-check SHA-only mode against
#     the ledger, board and roles AS COMMITTED AT THE TIP (git show), never the
#     working tree. A commit that changes only .team/ paths is exempt (it is the
#     ledger commit), and so is a commit identical to its first parent.
#     --allow-tip-only: when the remote tip is unknown (first push of the branch,
#     or a force push over a tip this clone never saw) and no TEAM_GATE_BASELINE
#     is set, only the tip is checked, with a loud warning. Set the baseline.
#     exit 0  => every code commit in the range has its required PASS rows,
#               bound to its exact SHA, independently authored. Push allowed.
#     exit !=0 => a commit is ungated/failed/self-signed, or the tip carries no
#               committed ledger. The checker prints which and why.
#   This hook is deliberately dumb: range + fail-closed only. All policy (which
#   gates, change classes, self-sign-off, roles) lives in gate-check, and the
#   range rules in gate-check-range, so BLOCK and CHECK stay separable.
#   The same gate-check-range runs on the server (ci/github/gate-check.yml), so
#   a push that passes here passes there, and a path this clone never sees is
#   still checked.
#
# UNTIL 1.0.x this hook gated the TIP ONLY from the WORKING-TREE ledger. That
#   made sessions hold the ledger uncommitted and forced a hollow self-signed
#   row for every ledger commit (field review 0008, 3A). The convention now:
#   code commits, then ONE .team-only ledger commit, then push.
#   Transition switch: TEAM_GATE_LEDGER_SOURCE=worktree reads the working tree
#   again (the server will not; use it only to migrate, then unset it).
#
# INSTALL
#   Run enforcement/install-hooks from the repo root (idempotent). Do not
#   hijack a live repo's hooks by hand; install-hooks is the opt-in path.
#
# CONFIGURE (env vars)
#   TEAM_PROTECTED_BRANCH   protected branch name   (default main)
#   TEAM_GATE_CHECK_RANGE   path to gate-check-range (default: resolved
#                           relative to this hook: ../../scripts/gate-check-range)
#   TEAM_GATE_CHECK         path to gate-check, passed through to the range checker
#   TEAM_GATE_BASELINE      last pre-adoption commit; bounds the range when the
#                           remote tip is unknown (retrofit onto an existing repo)
#   TEAM_GATE_LEDGER_SOURCE tip (default) | worktree (transition only)
#
# TESTS
#   The authoritative test is the REAL end-to-end integration suite in
#   ../../tests/integration-test, which installs the actual hooks and drives a
#   real git push/commit through them against the REAL gate-check (no stubs, so
#   the hook-to-gate-check contract is actually exercised). Run: sh tests/integration-test
#
#   Quick manual smoke (scratch repo; do NOT run against a real remote), driving
#   the hook against the real gate-check with a real ledger. Use a full SHA and a
#   ledger row that records the class for that SHA:
#     printf 'refs/heads/main <SHA> refs/heads/main 0000\n' | ./pre-push-gate origin url
#   PASSING : ledger has reviewer PASS by a non-author for <SHA>  -> exit 0
#   FAILING : ledger has no PASS (or a FAIL) for <SHA>            -> exit 2
#   UNGATED : ledger has no row for <SHA> at all                  -> exit 2 (fails closed)
#   FAIL-CLOSED : delete gate-check                               -> exit 2
#   PASS-THROUGH: push a non-main ref                             -> exit 0
# ============================================================================

set -eu

PROTECTED="${TEAM_PROTECTED_BRANCH:-main}"

# Resolve gate-check relative to this hook file. The kit layout is
# reliable-agent-team/enforcement/hooks/pre-push-gate and the scripts live at
# reliable-agent-team/scripts, so from the hook that is ../../scripts. We try the
# real layout first, then a couple of tolerant fallbacks, so it works whether the
# hook is invoked via a copied wrapper (exec of the real file), a symlink into
# .git/hooks, or core.hooksPath.
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${TEAM_GATE_CHECK_RANGE:-}" ]; then
	GATE_RANGE="$TEAM_GATE_CHECK_RANGE"
elif [ -e "$hook_dir/../../scripts/gate-check-range" ]; then
	GATE_RANGE="$hook_dir/../../scripts/gate-check-range"   # enforcement/hooks -> scripts
elif [ -e "$hook_dir/../scripts/gate-check-range" ]; then
	GATE_RANGE="$hook_dir/../scripts/gate-check-range"       # tolerant fallback
else
	GATE_RANGE="$hook_dir/../../scripts/gate-check-range"    # canonical, for the error message
fi

ZERO="0000000000000000000000000000000000000000"

# --- fail closed if the range checker is unavailable ------------------------
# Always run via `sh` so the gate still runs on filesystems without executable
# bits (Windows checkouts).
if [ -f "$GATE_RANGE" ]; then
	gate_run() { sh "$GATE_RANGE" "$@"; }
else
	printf '%s\n' \
		"BLOCKED by pre-push-gate (roadblock F2: merged before gates pass)." \
		"Required gate-check-range script not found: $GATE_RANGE" \
		"A missing checker fails CLOSED: a push to $PROTECTED cannot be" \
		"proven gated, so it is refused." \
		"Fix: install scripts/gate-check-range, or set TEAM_GATE_CHECK_RANGE to its path." >&2
	exit 2
fi

# --- inspect each ref being pushed (git feeds them on stdin) ----------------
BLOCKED=0
while read -r local_ref local_sha remote_ref remote_sha; do
	# blank line or deletion (local_sha all zeros) -> nothing to gate
	[ -z "${remote_ref:-}" ] && continue
	if [ "${local_sha:-$ZERO}" = "$ZERO" ]; then
		continue   # deleting a remote ref, no new commits to gate
	fi

	# does this ref target the protected branch?
	case "$remote_ref" in
		"refs/heads/$PROTECTED"|"$PROTECTED") : ;;
		*) continue ;;   # non-protected branch: pass through
	esac

	# Gate the WHOLE range remote..local against the ledger committed at the
	# tip. An unknown remote tip (all zeros) is passed through as no base; the
	# checker then uses TEAM_GATE_BASELINE, or the tip only with a warning.
	if [ "${remote_sha:-$ZERO}" = "$ZERO" ]; then
		set -- --tip "$local_sha" --allow-tip-only
	else
		set -- --tip "$local_sha" --base "$remote_sha" --allow-tip-only
	fi
	if gate_run "$@"; then
		: # every commit in the range is gated at the tip
	else
		gc_code=$?
		printf '%s\n' \
			"BLOCKED by pre-push-gate: push to '$PROTECTED' refused." \
			"Roadblock F2 (merged before gates pass) / gate-bound-to-SHA." \
			"gate-check-range exited $gc_code (its lines above name each commit and why)." \
			"The ledger of record is .team/ AS COMMITTED AT $local_sha, not your working tree." \
			"Fix: record the required reviewer/security/qa PASS rows for each listed commit" \
			"(bound to its FULL sha), commit .team on top as its own commit, push again." >&2
		BLOCKED=1
	fi
done

[ "$BLOCKED" -eq 0 ] || exit 2
exit 0
