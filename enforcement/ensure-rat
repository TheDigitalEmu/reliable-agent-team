#!/bin/sh
# ============================================================================
# ensure-rat : make an agent AWARE the reliable-agent-team plugin is present,
#              at what version, and warn (never act) when it is behind upstream.
# ----------------------------------------------------------------------------
# WHY THIS EXISTS (the gap it closes)
#   The SessionStart version check only fires for a copy wired as a plugin hook.
#   An agent that reaches the kit through a SKILL (install or update) otherwise
#   learns nothing about its version or staleness. This script is the missing
#   half, run from the skills: it reports the plugin's own version and, if the
#   public repo is ahead, that an update is available. The kit does the same for
#   its owasp dependency (see ensure-owasp); this turns it on RAT itself.
#
#   It reads the VERSION shipped ALONGSIDE this script (the plugin root is this
#   script's ../../), so it never has to guess an install path: wherever the
#   plugin lives, its VERSION travels with it. That is the whole reliability of
#   this check.
#
# WHAT IT DOES (detect, never act)
#   1. Resolve the plugin root from this script's location and read its VERSION,
#      so the agent is AWARE the kit is present and at what version.
#   2. Fetch the pinned public VERSION (HTTPS only, no redirect, short timeout)
#      and compare. If behind, print how to update (ask; the update skill does
#      it). If ahead, treat the remote as suspicious. Never pull.
#   3. Fail OPEN on any network trouble: the local-awareness line still prints;
#      the behind-check is skipped.
#
# WHAT IT NEVER DOES (same envelope as session-version-check / ensure-owasp)
#   - Never auto-pulls. Never fetches-then-executes. Applying an update is done
#     by the update skill (shows the diff, fast-forwards), never a silent pull.
#   - Never follows a cross-host redirect for the version string.
#   - Never blocks: a lower remote is reported suspicious, not applied; offline
#     or tool-less runs still succeed with the local-awareness line.
#
# EXIT CODES
#   0  plugin VERSION found (awareness printed; current or behind-with-warning).
#   3  no readable VERSION next to this script (unexpected install shape).
#      Printed as a note, not a hard error.
#
# CONFIGURE (env, all optional)
#   RAT_ROOT            plugin root to read VERSION from (default: this script's
#                       ../../). Override for testing.
#   RAT_VERSION_URL     pinned raw URL of the public VERSION
#   RAT_VERSION_TIMEOUT fetch timeout seconds (default 2)
# ============================================================================

set -eu

PROG="$(basename "$0")"

# Plugin root: this script is at <root>/enforcement/ensure-rat, so root is ../..
script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT="${RAT_ROOT:-$(CDPATH= cd -- "$script_dir/.." && pwd)}"
VERSION_FILE="$ROOT/VERSION"

DEFAULT_URL="https://raw.githubusercontent.com/TheDigitalEmu/reliable-agent-team/main/VERSION"
URL="${RAT_VERSION_URL:-$DEFAULT_URL}"
TIMEOUT="${RAT_VERSION_TIMEOUT:-2}"

# Read a dotted version token from a file: first non-blank, non-# line, trimmed.
read_version_token() {
	awk 'NF { line=$0; sub(/^[ \t\r]+/,"",line); if (substr(line,1,1) != "#") { print line; exit } }' 2>/dev/null \
		| tr -d ' \t\r\n' 2>/dev/null || true
}

# --- awareness: read the plugin's own VERSION -------------------------------
if [ ! -f "$VERSION_FILE" ]; then
	printf '%s: no VERSION found at %s (unexpected install shape).\n' "$PROG" "$VERSION_FILE"
	exit 3
fi
LOCAL="$(read_version_token < "$VERSION_FILE")"
[ -n "$LOCAL" ] || { printf '%s: VERSION at %s is empty.\n' "$PROG" "$VERSION_FILE"; exit 3; }

printf '%s: reliable-agent-team is installed at %s (version %s).\n' "$PROG" "$ROOT" "$LOCAL"

# Local must be a dotted numeric token to compare. If not, stay aware, stop.
case "$LOCAL" in
	*[!0-9.]*) exit 0 ;;
esac

# --- behind-check: fetch pinned public VERSION, compare, warn only ----------
fetch_remote() {
	case "$URL" in
		https://*) : ;;
		*) return 1 ;;
	esac
	if command -v curl >/dev/null 2>&1; then
		curl -fs --proto '=https' --tlsv1.2 --max-time "$TIMEOUT" -- "$URL" 2>/dev/null
		return $?
	fi
	if command -v wget >/dev/null 2>&1; then
		wget -q --max-redirect=0 -T "$TIMEOUT" -O- -- "$URL" 2>/dev/null
		return $?
	fi
	return 1
}

REMOTE_RAW="$(fetch_remote || true)"
REMOTE="$(printf '%s\n' "${REMOTE_RAW:-}" | read_version_token)"

# No remote, or junk: fail open (awareness already printed).
[ -n "$REMOTE" ] || exit 0
case "$REMOTE" in
	*[!0-9.]*) exit 0 ;;
esac

cmp_versions() {
	l="$1"; r="$2"
	oldifs="$IFS"; IFS='.'
	# shellcheck disable=SC2086
	set -- $l; l1="${1:-0}"; l2="${2:-0}"; l3="${3:-0}"
	# shellcheck disable=SC2086
	set -- $r; r1="${1:-0}"; r2="${2:-0}"; r3="${3:-0}"
	IFS="$oldifs"
	l1=${l1%%[!0-9]*}; l2=${l2%%[!0-9]*}; l3=${l3%%[!0-9]*}
	r1=${r1%%[!0-9]*}; r2=${r2%%[!0-9]*}; r3=${r3%%[!0-9]*}
	for pair in "$l1 $r1" "$l2 $r2" "$l3 $r3"; do
		a=${pair% *}; b=${pair#* }
		a=${a:-0}; b=${b:-0}
		if [ "$a" -lt "$b" ]; then echo local_behind; return; fi
		if [ "$a" -gt "$b" ]; then echo local_ahead; return; fi
	done
	echo eq
}

case "$(cmp_versions "$LOCAL" "$REMOTE")" in
	eq)
		exit 0 ;;
	local_behind)
		printf '%s\n' \
			"[reliable-agent-team] Your installed kit is behind the public repo." \
			"  installed: $LOCAL   available: $REMOTE" \
			"  To update, just ask: \"update reliable-agent-team\" (or run the" \
			"  reliable-agent-team update skill). It shows what changed and applies" \
			"  it for you. You do not type any git command." \
			"  (This check only warns. It does not pull or run anything.)" >&2
		exit 0 ;;
	local_ahead)
		printf '%s\n' \
			"[reliable-agent-team] Note: your installed kit ($LOCAL) is NEWER than" \
			"the public repo ($REMOTE). If unexpected, treat the remote as suspicious" \
			"(stale mirror or tampering) and do NOT downgrade." >&2
		exit 0 ;;
esac

exit 0
